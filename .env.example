# Copy to .env.local and fill in. Never commit the filled version.
# Every variable the application reads is documented here.

# ── Database ────────────────────────────────────────────────
# Must be a NON-SUPERUSER role without BYPASSRLS, or tenant isolation
# is silently disabled. See README.
DATABASE_URL="postgresql://lih_app:PASSWORD@host:5432/lih?schema=public"
# Separate superuser connection for migrations only.
DIRECT_URL="postgresql://postgres:PASSWORD@host:5432/lih?schema=public"

# ── Auth ────────────────────────────────────────────────────
AUTH_SECRET=""              # 32+ random bytes
AUTH_URL="http://localhost:3000"

# ── Maps (Slice 4) ──────────────────────────────────────────
# Server-side key: restricted by IP, used for geocoding.
GOOGLE_MAPS_SERVER_KEY=""
# Browser key: restricted by HTTP referrer. This one IS public.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# ── Stripe (Slice 9) ────────────────────────────────────────
# Without STRIPE_SECRET_KEY, billing is "not configured": checkout is hidden
# and the webhook returns 503 — plans still govern entitlements, but no
# payments. Set the price IDs on each Plan row (stripe_price_id_monthly/yearly)
# to make a plan purchasable.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""       # verifies inbound Stripe webhook signatures
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Background jobs (Slices 12/13) ──────────────────────────
# A scheduler POSTs to /api/jobs/run (sync queue) and /api/jobs/rollup
# (analytics rollups + scheduled content publishing) with
# "Authorization: Bearer $JOBS_RUN_SECRET". Without it, those routes 503.
JOBS_RUN_SECRET=""

# ── Media storage (Slice 7) ─────────────────────────────────
# Default "local" writes uploads under ./storage/media (gitignored) served by
# /media. On an ephemeral filesystem (Cloud Run) point MEDIA_LOCAL_DIR at a
# mounted volume, or implement a cloud MediaStore and set MEDIA_STORAGE.
MEDIA_STORAGE="local"
MEDIA_LOCAL_DIR=""             # defaults to <cwd>/storage/media

# ── GoHighLevel (Slice 12) ──────────────────────────────────
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_WEBHOOK_SECRET=""       # verifies inbound webhook signatures
GHL_REDIRECT_URI="http://localhost:3000/api/integrations/ghl/callback"

# ── Google Business Profile (Slice 11) ──────────────────────
GBP_CLIENT_ID=""
GBP_CLIENT_SECRET=""
GBP_REDIRECT_URI="http://localhost:3000/api/integrations/gbp/callback"

# ── Storage ─────────────────────────────────────────────────
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Email ───────────────────────────────────────────────────
SMTP_URL=""
MAIL_FROM="hello@example.co.uk"

# ── Encryption ──────────────────────────────────────────────
# Encrypts IntegrationConnection.credentialsEncrypted at rest.
# Rotating this invalidates all stored OAuth tokens.
CREDENTIALS_ENCRYPTION_KEY=""   # 32 bytes, base64

# ── Redis (rate limiting, caching) ──────────────────────────
REDIS_URL=""
