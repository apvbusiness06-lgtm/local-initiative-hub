# Multi-domain reverse proxy for the Local Initiative platform.
#
# The app resolves the tenant from the incoming Host header (lib/tenant.ts),
# so ONE running app instance serves every tenant domain. The proxy's only
# jobs are TLS termination and forwarding the ORIGINAL Host through unchanged
# — if the Host is rewritten, tenant resolution breaks and every request 404s
# to the branded "unknown directory" page.
#
# TLS: a wildcard cert (*.localinitiative.co.uk) covers subdomain tenants;
# custom tenant domains (e.g. hampshirelocal.co.uk) each need their own cert.
# Certbot with the nginx plugin, or Cloudflare in front, handles issuance.

# Redirect all HTTP to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name .localinitiative.co.uk hampshirelocal.co.uk;   # add custom domains here
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    # One server block serves every tenant host. Add custom tenant domains to
    # this list (and issue certs for them) as they onboard.
    server_name .localinitiative.co.uk hampshirelocal.co.uk;

    # Wildcard for subdomain tenants; SNI picks the right cert per host.
    ssl_certificate     /etc/letsencrypt/live/localinitiative.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/localinitiative.co.uk/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # HSTS belongs here (HTTPS is terminated at this layer).
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    client_max_body_size 12m;   # matches the app's 10 MB Server Action limit + overhead

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;

        # CRITICAL: forward the original Host unchanged for tenant resolution.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }
}

# ── Custom-domain onboarding (per tenant) ────────────────────
# 1. Tenant points a CNAME/A record at this proxy's address.
# 2. Add a TenantDomain row (hostname) and verify it — the app refuses to
#    serve an unverified custom domain (lib/tenant.ts checks verifiedAt), so a
#    stranger can't point DNS at us and impersonate a tenant.
# 3. Issue a cert for the domain (certbot --nginx -d newdomain.co.uk) and add
#    it to server_name above, or run Cloudflare in front for automatic TLS.
